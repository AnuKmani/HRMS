<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: local UAT talks to `php artisan serve` over plain
         http on the LAN (http://<pc-ip>:8000), which Android 9+ refuses by
         default. Merged into the main manifest for debug; release builds
         never see it and stay HTTPS-only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
