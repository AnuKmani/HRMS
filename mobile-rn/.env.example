# The Laravel API this app talks to: <backend URL> + /api/v1
# Staging example: https://hrms-staging.laravel.cloud/api/v1
# Laptop on the same Wi-Fi (testing): http://192.168.1.164:8000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.164:8000/api/v1

# true = the login screen lets a tester change the server address.
EXPO_PUBLIC_ALLOW_SERVER_SETTING=true
