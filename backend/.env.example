APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Authentication (Phase 3)
# ---------------------------------------------------------------------------
# Read through config/rate_limiting.php, so tightening a limit is a change
# here rather than a hunt through the route files for a literal.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_DECAY_MINUTES=1

PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_DECAY_MINUTES=15

# The forgot-password and reset-password endpoints are implemented and
# routed, but answer 501 while this is false: with MAIL_MAILER=log the
# message is filed into storage/logs rather than sent, and claiming "check
# your inbox" when nothing was sent would be misleading. Set to true
# together with a mailer that can actually deliver.
PASSWORD_RESET_ENABLED=false

# ---------------------------------------------------------------------------
# Attendance & geofence (Phase 5)
# ---------------------------------------------------------------------------
# Limits, not secrets: they bound what a device may claim, and they read
# through config/hrms.php and config/rate_limiting.php so a deployment
# tightens them here instead of editing route or validation code.
GEOFENCE_MIN_RADIUS_METRES=10
GEOFENCE_MAX_RADIUS_METRES=10000

ATTENDANCE_MAX_GPS_ACCURACY_METRES=100
ATTENDANCE_VALIDATE_CHECKOUT_GEOFENCE=true

ATTENDANCE_RATE_LIMIT_MAX_ATTEMPTS=30
ATTENDANCE_RATE_LIMIT_DECAY_MINUTES=1

# ---------------------------------------------------------------------------
# Private file storage — attendance selfies & leave medical certificates
# ---------------------------------------------------------------------------
# Directories are relative to the `local` disk root (storage/app/private),
# which has no public URL and no route that lists it. Filenames are minted by
# the server; nothing supplied by a client reaches the disk.
#
# HRMS_SELFIE_MAX_PIXELS bounds width x height, not "per edge" — it is what
# stops a crafted gigapixel file from being decoded before it is refused.
# HRMS_SELFIE_JPEG_QUALITY is what SelfieSanitizer re-encodes to, and that
# re-encoding is what discards EXIF (GPS fix, camera model, software string).
HRMS_SELFIE_DIRECTORY=attendance-selfies
HRMS_SELFIE_MAX_KB=5120
HRMS_SELFIE_MAX_PIXELS=16777216
HRMS_SELFIE_JPEG_QUALITY=85

# Certificates are validated (MIME type + size + byte signature) and stored
# as-is: a doctor's note must not be re-encoded, because re-encoding is what
# a photo needs and what a PDF would be damaged by.
HRMS_CERTIFICATE_DIRECTORY=leave-certificates
HRMS_CERTIFICATE_MAX_KB=5120

# ---------------------------------------------------------------------------
# Employee documents (Phase 10)
# ---------------------------------------------------------------------------
# The most sensitive files this application holds — passports, Emirates IDs,
# visas, contracts — live on the private `local` disk under a name the server
# mints ({employeeId}/{uuid}.{ext}). Nothing supplied by a client reaches the
# path, so the directory below is the only knob.
#
# Images are re-encoded through the same SelfieSanitizer the selfie uses, so
# no EXIF (GPS fix, camera model) survives a photograph of an identity
# document; PDFs are kept byte-for-byte because a document that is not the
# one that was filed stops being a document anybody can open.
#
# The WARNING window is deliberately NOT these env vars: which type warns
# early, and by how many days, is a column on `document_types`
# (expiry_warning_days). HRMS_DOCUMENT_WARNING_DAYS is only the fallback for
# a type that says nothing — NULL on a type means "use this", never "never
# warn".
HRMS_DOCUMENT_DIRECTORY=employee-documents
HRMS_DOCUMENT_MAX_KB=10240
HRMS_DOCUMENT_WARNING_DAYS=30
HRMS_DOCUMENT_SCAN_HOUR=6
HRMS_DOCUMENT_SCAN_MINUTE=15

# ---------------------------------------------------------------------------
# Sick-certificate deadline enforcement (Phase 6)
# ---------------------------------------------------------------------------
# The scheduler enforces the deadline at this minute of every hour, and the
# overlap mutex is how a run that hangs cannot be doubled by the next tick.
# The DEADLINE ITSELF (2 days by default) is a database-managed business
# setting — `leave.sick_certificate_deadline_days`, overridable per leave
# type by `document_deadline_days` — and is deliberately NOT an env var:
# an administrator changes it in the database, not in a deployment.
HRMS_SICK_TICK_MINUTE=17
HRMS_SICK_OVERLAP_MINUTES=60

# ---------------------------------------------------------------------------
# Scheduler & queue — production requirements (Phase 6)
# ---------------------------------------------------------------------------
# QUEUE_CONNECTION=database above is correct for local development, and the
# `jobs`, `failed_jobs` and `job_batches` tables it needs are migrated with
# the application (0001_01_01_000002_create_jobs_table). Tests force
# QUEUE_CONNECTION=sync via phpunit.xml.
#
# Neither of the two processes below can start themselves. Without the first,
# no deadline is ever enforced; without the second, the job that enforces it
# sits in the jobs table untouched. See docs/DEPLOYMENT.md.
#
#   * * * * * cd /path/to/backend && php artisan schedule:run >> /dev/null 2>&1
#
#   php artisan queue:work --stop-when-empty
#
# Run the worker under Supervisor or systemd, not in a shell somebody has to
# remember to leave open.
